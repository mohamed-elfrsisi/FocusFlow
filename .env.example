# Copy to `.env` (git-ignored). Read by `docker compose` only.
# The API itself does NOT read this file: use `dotnet user-secrets` locally (see docs/development-guide.md).
# Full list of API variables: docs/environment.example

# SQL Server "sa" password for the local Docker database.
# SQL Server rule: at least 8 characters, with 3 of: upper case, lower case, digit, symbol.
MSSQL_SA_PASSWORD=ChangeMe_Local_Only_1!
